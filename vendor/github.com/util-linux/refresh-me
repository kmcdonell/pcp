#!/bin/sh
#
# script to refresh sys-utils/lscpu-arm.c from github
#

sts=1
tmp=/tmp/refresh-me-$$
mkdir $tmp || exit
trap "rm -rf $tmp; exit \$sts" 0 1 2 3 15

if ! wget -o $tmp/err -O $tmp/lscpu-arm.c https://raw.githubusercontent.com/util-linux/util-linux/refs/heads/master/sys-utils/lscpu-arm.c
then
    cat $tmp/err
    echo >&2 "Error: wget failed"
    exit
fi

if [ ! -s $tmp/lscpu-arm.c ]
then
    cat $tmp/err
    echo >&2 "Error: wget returned an empty file"
    exit
fi

if [ -f lscpu-arm.c ]
then
    if diff $tmp/lscpu-arm.c lscpu-arm.c 
    then
	echo >&2 "lscpu-arm.c: no change"
    else
	mv $tmp/lscpu-arm.c lscpu-arm.c
	echo >&2 "lscpu-arm.c: updated"
    fi
else
    mv $tmp/lscpu-arm.c lscpu-arm.c
    echo >&2 "lscpu-arm.c: installed"
fi

sts=0
exit
