#!/bin/sh
#
# Use source from github.com/util-linux/util-linux/sys-utils/lscpu-arm.c
# (and associated include files) to create our arm_cpuinfo.c and arm_cpuinfo.h
#

tmp=/tmp/mk.arm_cpuinfo-$$
sts=1		# failure is the default
trap "rm -f $tmp.*; exit \$sts" 0 1 2 3 15

cat <<End-of-File | while read src dst
lscpu-arm.c	$tmp.c
lscpu.h		$tmp.h
End-of-File
do
    src="../../../vendor/github.com/util-linux/sys-utils/$src"
    if [ ! -f "$src" ]
    then
	echo "Arrgh: $src missing"
	exit
    fi
    cp "$src" "$dst"
done

rm -f arm_cpuinfo.h arm_cpuinfo.c

awk <$tmp.c >arm_cpuinfo.c '
# state
# 0 before 1st comment
# 1 in first comment (ends at line with "*/" as first word)
# 2 looking for something to extract
# 3 in a array declaration to be extracted (ends at line with "};" as first word)
BEGIN		{ state = 0; want = 0 }
state == 0 && $1 == "/*"	{
		  print
		  print " * Map numeric arm64 (aka aarch64) CPU identifiers to symbolic names"
		  print " * Generated by mk.arm_cpuinfo from github.com/util-linux/util-linux/sys-utils/lscpu-arm.c"
		  print " * DO NOT EDIT THIS FILE"
		  print " * ..."
		  print " * Copyright (c) 2026 Ken McDonell.  All Rights Reserved."
		  print " *"
		  state = 1
		  next
		}	
state == 2 && /^#define FL_FOLLOW/	{ print; next }
state == 2 && /^static .* hw_implementer\[] = {/	{
		  print ""
		  print
		  state = 3
		  next
		}
state == 2 && /^static const struct id_part / {
		  print ""
		  print
		  state = 3
		  next
		}
state == 2 && /^struct hw_impl {/ {
		  print ""
		  print
		  state = 3
		  next
		}
state == 2 && /^struct id_part {/ {
		  print ""
		  print
		  state = 3
		  next
		}
state == 1 || state == 3	{
		  print
		  if (state == 1 && $1 == "*/") state = 2
		  if (state == 3 && $1 == "};") state = 2
		}
'

cat <<'End-of-File' >>arm_cpuinfo.c

#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "pmapi.h"
#include "arm_cpuinfo.h"

/*
 * we assume implementor does not change across calls, so we can
 * do the hw_implementer[] lookup just once and remember the result
 * ditto for the associated parts[] array
 */
static const struct hw_impl	*impl_cache;
static const struct id_part	*part_cache;
static int			onetrip = 1;

static void
arm_cpuinfo_init(const char *implementer)
{
    int				i;
    long			id;
    char			*pend;

    if (!onetrip)
	return;

    part_cache = NULL;
    if (strncmp(implementer, "0x", 2) != 0) {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_init(%s) -> error: no 0x hex prefix\n", implementer);
	impl_cache = NULL;
	return;
    }
    id = strtol(&implementer[2], &pend, 16);
    if (*pend != '\0') {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_init(%s) -> %ld error: not a hex number\n", implementer, id);
	impl_cache = NULL;
	return;
    }
    if ((unsigned int)id != id) {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_init(%s) -> %ld error: too big id != (int)id %u\n", implementer, id, (unsigned int)id);
	impl_cache = NULL;
	return;
    }

    /* implementer table has an id == -1 sentinel at the end */
    for (i = 0; hw_implementer[i].id >= 0; i++) {
	if (hw_implementer[i].id == id) {
	    impl_cache = &hw_implementer[i];
	    part_cache = (const struct id_part *)hw_implementer[i].parts;
	    if (pmDebugOptions.appl9)
		fprintf(stderr, "arm_cpuinfo_init(%s) -> implementer %ld (%s)\n", implementer, id, impl_cache->name);
	    return;
	}
    }

    if (pmDebugOptions.appl9)
	fprintf(stderr, "arm_cpuinfo_init(%s) -> %ld -> error: no id match\n",  implementer, id);
    impl_cache = NULL;
    return;
}

const char *
arm_cpuinfo_vendor(const char *implementer)
{
    if (onetrip)
	arm_cpuinfo_init(implementer);
    if (impl_cache != NULL) {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_vendor(%s) -> %s\n", implementer, impl_cache->name);
	return impl_cache->name;
    }
    else
	return NULL;
}

const char *
arm_cpuinfo_part(const char *part)
{
    int				i;
    long			id;
    char			*pend;

    if (part_cache == NULL) {
	/*
	 * expect arm_cpuinfo_init() to be called from arm_cpuinfo_vendor()
	 * before we are called here
	 */
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_part(%s): Botch: part_cache is NULL\n", part);
	return NULL;
    }

    if (strncmp(part, "0x", 2) != 0) {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_part(%s) -> error: no 0x hex prefix\n", part);
	return NULL;
    }
    id = strtol(&part[2], &pend, 16);
    if (*pend != '\0') {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_part(%s) -> %ld error: not a hex number\n", part, id);
	return NULL;
    }
    if ((unsigned int)id != id) {
	if (pmDebugOptions.appl9)
	    fprintf(stderr, "arm_cpuinfo_part(%s) -> %ld error: too big id != (int)id %u\n", part, id, (unsigned int)id);
	return NULL;
    }


    /* each part table has an id == -1 sentinel at the end */
    for (i = 0; part_cache[i].id >= 0; i++) {
	if (part_cache[i].id == id) {
	    if (pmDebugOptions.appl9)
		fprintf(stderr, "arm_cpuinfo_part(%s) -> part %ld (%s)\n", part, id, part_cache[i].name);
	    return part_cache[i].name;
	}
    }

    if (pmDebugOptions.appl9)
	fprintf(stderr, "arm_cpuinfo_part(%s) -> %ld -> error: no id match\n",  part, id);
    return NULL;
}

End-of-File

awk <$tmp.h >arm_cpuinfo.h '
# state
# 0 before 1st comment
# 1 in first comment (ends at line with "*/" as first word)
# 2 looking for something to extract
# 3 in a array declaration to be extracted (ends at line with "};" as first word)
BEGIN		{ state = 0; want = 0 }
state == 0 && $1 == "/*"	{
		  print
		  print " * Map numeric arm64 (aka aarch64) CPU identifiers to symbolic names"
		  print " * Generated by mk.arm_cpuinfo from github.com/util-linux/util-linux/sys-utils/lscpu.h"
		  print " * DO NOT EDIT THIS FILE"
		  print " * ..."
		  print " * Copyright (c) 2026 Ken McDonell.  All Rights Reserved."
		  print " *"
		  state = 1
		  next
		}	
state == 1 || state == 3	{
		  print
		  if (state == 1 && $1 == "*/") state = 2
		  if (state == 3 && $1 == "};") state = 2
		}
'

cat <<'End-of-File' >>arm_cpuinfo.h

extern const char *arm_cpuinfo_vendor(const char *);
extern const char *arm_cpuinfo_part(const char *);
End-of-File

chmod u-w,g-w,o-w arm_cpuinfo.h arm_cpuinfo.c

sts=0
exit
